{
  "rewrites": [
    {
      "source": "/((?!_sys_).*\\.(?:js|css))",
      "destination": "/api/invalid.js"
    },
    {
      "source": "/(_sys_.*\\.(?:js|css))",
      "has": [
        {
          "type": "header",
          "key": "sec-fetch-dest",
          "value": "document"
        }
      ],
      "destination": "/api/invalid.js"
    }
  ]
}
